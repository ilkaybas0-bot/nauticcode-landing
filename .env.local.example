# Get a key at https://resend.com (free tier available)
RESEND_API_KEY=re_your_api_key_here

# Where audit request emails are delivered
CONTACT_EMAIL_TO=ilkaybas0@gmail.com

# Must be a Resend-verified domain in production.
# The default below only works for sending to your own Resend account email.
CONTACT_EMAIL_FROM=NauticCode Audit Bot <onboarding@resend.dev>

# Optional: persistent rate limiting for /api/contact via Upstash Redis
# (free tier at https://upstash.com). Without these, the API falls back to
# an in-memory limiter that resets on cold start — fine for local dev, not
# for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
